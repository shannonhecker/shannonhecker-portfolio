---
// One essay: a page in the same language as the case pages (white or dark page,
// one grotesk, hairlines, air). The Markdown body arrives in the default slot;
// the title, dates and counts come from the entry's front matter. The "Previously"
// and "Next post" links are built from the dates, as the old pages had them.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { CollectionEntry } from 'astro:content';
import { bodyStats, isoDate, thousands } from '../lib/writing';
import '../styles/writing.css';

interface Props {
  entry: CollectionEntry<'writing'>;
  /** The essay written just before this one. */
  older?: CollectionEntry<'writing'>;
  /** The essay written just after this one. */
  newer?: CollectionEntry<'writing'>;
}
const { entry, older, newer } = Astro.props;
const { title, description, published, dek, keywords } = entry.data;
const date = isoDate(published);
// Length is read off the body, so it cannot drift from the text.
const { words, shown, minutes } = bodyStats(entry);

const page = new URL(`/writing/${entry.id}`, Astro.site).href;
const share = new URL('/og-card.png', Astro.site).href;
const author = { '@type': 'Person', name: 'Shannon Hecker', url: 'https://shannonhecker.com' };

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url: page,
    image: share,
    datePublished: date,
    dateModified: date,
    author,
    publisher: author,
    mainEntityOfPage: { '@type': 'WebPage', '@id': page },
    wordCount: words,
    inLanguage: 'en-GB',
    keywords: keywords.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shannonhecker.com/' },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: 'https://shannonhecker.com/writing' },
      { '@type': 'ListItem', position: 3, name: title, item: page },
    ],
  },
];
---
<Base title={`${title} · Shannon Hecker`} description={description} ogType="article">
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" class="essay">
    <div class="wrap">
      <article>
        <header class="essay-head">
          <p class="essay-crumb"><a href="/writing">Writing</a></p>
          <h1>{title}.</h1>
          <div class="essay-intro">
            <p class="essay-dek">{dek}</p>
            <dl class="essay-facts">
              <div><dt>Author</dt><dd>Shannon Hecker</dd></div>
              <div><dt>Published</dt><dd><time datetime={date}>{date}</time></dd></div>
              <div><dt>Length</dt><dd><span class="nb">{minutes} minute read</span> <span aria-hidden="true">·</span> <span class="nb">{thousands(shown)} words</span></dd></div>
            </dl>
          </div>
        </header>

        <div class="essay-body"><slot /></div>

        <footer class="essay-end">
          <p class="essay-bio">
            <strong>Shannon Hecker</strong> is a product designer in London. She designs trading and markets tools at <a href="https://www.barclays.com" target="_blank" rel="noopener noreferrer">Barclays<span class="vh"> (opens in new tab)</span></a>, after nine years at <a href="https://www.jpmorgan.com" target="_blank" rel="noopener noreferrer">J.P. Morgan<span class="vh"> (opens in new tab)</span></a> ending as Digital Product Designer VP on the Fusion platform. She is building <a href="/uoaui">uoaui.ai</a> on the side. A multi-design-system component composition tool for designers who think in systems. Get in touch via <a href="mailto:shannonheckerchen@gmail.com">email</a> or <a href="https://www.linkedin.com/in/shannonhecker" target="_blank" rel="noopener noreferrer">LinkedIn<span class="vh"> (opens in new tab)</span></a>.
          </p>
          <nav class="essay-pager" aria-label="More writing">
            {newer && (
              <a href={`/writing/${newer.id}`} data-cursor="big">
                <span class="kicker">Next post</span>
                <span class="t">{newer.data.title}<span class="arrow" aria-hidden="true">→</span></span>
              </a>
            )}
            {older && (
              <a href={`/writing/${older.id}`} data-cursor="big">
                <span class="kicker">Previously</span>
                <span class="t">{older.data.title}<span class="arrow" aria-hidden="true">→</span></span>
              </a>
            )}
          </nav>
          <p class="essay-all"><a href="/writing"><span class="kicker">Writing</span><span class="t">All writing<span class="arrow" aria-hidden="true">→</span></span></a></p>
        </footer>
      </article>
    </div>
  </main>
  <Footer />
  {ld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
</Base>
