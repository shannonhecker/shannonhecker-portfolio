---
import '../styles/project-story.css';
import ProjectMasthead from '../components/ProjectMasthead.astro';
import Icon from '../components/Icon.astro';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CaseRowLink from '../components/CaseRowLink.astro';
import { projectOverviews } from '../lib/project-overviews';
import { CASES } from '../lib/cases';
import { CASE_WORLD } from '../lib/journey';

interface Props { title: string; href: keyof typeof projectOverviews }
const { title, href } = Astro.props;
const i = CASES.findIndex((c) => c.href === href);
// Description is the case's own index-row text: no new copy.
const description = CASES[i].meta;
// Each case with a world in the game links to it (World map in the hero).
const level = href in CASE_WORLD ? CASE_WORLD[href] + 1 : 0;
const overview = projectOverviews[href];
const next = CASES[(i + 1) % CASES.length];
const nextOverview = projectOverviews[next.href];
---
<Base title={`${title} · Shannon Hecker`} description={description}>
  <div class="progress" aria-hidden="true"></div>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" class="case-page" data-project={href.slice(1)}>
    <article class="wrap project-overview">
      <ProjectMasthead title={title} backLabel="All projects" backHref="/work" facts={'nda' in overview ? [] : [
        { label: 'Organisation', value: overview.organisation },
        { label: 'Year', value: overview.period },
        { label: 'Role', value: overview.role },
      ]} />
      <div class="overview-art"><slot /></div>
      <h1 class="project-story-title" style={`view-transition-name:t-${CASES[i].vt}`}>{title}</h1>
      {!('nda' in overview) && <>
        <p class="project-story-lead">{overview.lead}</p>
        <section class="project-notes" aria-labelledby="project-about">
          <h2 id="project-about">About this project</h2>
          <div class="project-notes-body">
            <section><h3>My contribution</h3><p>{overview.contribution}</p></section>
            {overview.decisions.map((decision, index) => (
              <section>
                <h3>{decision.title}</h3>
                {decision.paragraphs.map(paragraph => <p>{paragraph}</p>)}
                {index === 0 && <slot name="evidence" />}
              </section>
            ))}
            <section class="project-outcome" aria-labelledby="outcome">
              <h3 id="outcome">Outcome</h3>
              <p>{overview.outcome}</p>
              {overview.links.length > 0 && <div class="product-links">{overview.links.map(link => <a href={link.href} target="_blank" rel="noopener">{link.label}<Icon name="external" /><span class="vh"> (opens in new tab)</span></a>)}</div>}
            </section>
          </div>
        </section>
      </>}
      <slot name="notice" />
    </article>
    {level > 0 && (
      <p class="wrap play-link"><a href={`/?level=${level}#adventure`}>Play this chapter in the game <Icon name="arrow-right" /></a></p>
    )}
    <section class="band next-case" aria-label="Next case">
      <div class="wrap"><div class="index"><CaseRowLink c={next} description={`${nextOverview.organisation} · ${nextOverview.period}`} /></div></div>
    </section>
  </main>
  <Footer />
</Base>
<style>
.project-overview{padding-top:clamp(100px,10vw,160px);padding-bottom:clamp(40px,5vw,80px)}
.product-links a{display:inline-flex;align-items:center;gap:6px;min-height:44px;color:var(--fg);text-underline-offset:4px}
.overview-art{width:100%;margin:0 auto}
.overview-art :global(.project-hero),.overview-art :global(.product-capture){margin:0 auto;width:100%;max-width:760px}
.overview-art :global(.fusion-hero){max-width:680px}
.overview-art :global(.nda-cover){max-width:1040px;margin-inline:auto}
.project-overview :global(.nda-summary){margin:clamp(24px,4vw,56px) 0 0}
.project-notes-body p + p{margin-top:1em}
.product-links{display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:12px}
</style>
<script>
  import '../scripts/motion.ts';
</script>
