---
import Icon from './Icon.astro';
import LandingCompanion from './LandingCompanion.astro';
import WaveField from './WaveField.astro';
// Named by the whole sentence; the word windows are hidden from assistive tech.
const heading = ['I', 'design', 'tools', 'where', 'mistakes', 'cost', 'money.'];
---
<header id="top" data-tone="light" class="hero adventure-hero has-wave-field">
  <WaveField variant="hero" avoid=".landing-companion" />
  <div class="wrap">
    <div class="hero-story">
      <h1 class="h-giant" aria-label={heading.join(' ')}>{heading.map((word, index) => <><span class="hero-word-window" aria-hidden="true"><span class="hero-word">{word}</span></span>{index < 6 ? ' ' : ''}</>)}</h1>
      <p class="hero-top"><span class="hero-copy-depth">I’m Shannon Hecker, a product designer in London. I lead design for FX and MarketsOne at Barclays. I build what I design.</span></p>
      <a class="explore-work" href="#work">Explore my work<Icon name="arrow-down" /></a>
    </div>
    <LandingCompanion />
  </div>
</header>
