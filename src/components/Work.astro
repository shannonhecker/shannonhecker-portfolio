---
import { CASES } from '../lib/cases';
import { projectOverviews } from '../lib/project-overviews';
import CaseRowLink from './CaseRowLink.astro';
import '../styles/project-gallery.css';
---
<section id="work" data-tone="light" class="band featured-work" aria-labelledby="work-heading">
  <div class="wrap">
    <h2 id="work-heading" class="work-title">Featured work</h2>
    <div class="index project-gallery featured-gallery">
      {CASES.map(c => <CaseRowLink c={c} homeArtwork description={projectOverviews[c.href].card} />)}
    </div>
    <p class="more-work"><a href="/work">View all work</a></p>
  </div>
</section>
