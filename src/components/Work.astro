---
import { CASES } from '../lib/cases';
import CaseRowLink from './CaseRowLink.astro';

---
<section id="work" data-tone="light" class="band home-work">
  <div class="wrap">
    <div class="g" style="row-gap:40px;margin-bottom:clamp(48px,6vw,96px)">
      <h2 class="work-title">Selected work</h2><p class="eyebrow work-method">Five cases, one method</p>
      <p class="work-description">Trading, analytics, deal pricing and the products I build myself. These are the decisions I made, the alternatives I tried and what happened next.</p>
    </div>
    <div class="index">
      {CASES.map((c) => <CaseRowLink c={c} homeArtwork />)}
    </div>
    <p class="more-work"><a href="/work">More work</a></p>
  </div>
</section>

<style>
/* The number sits in a fixed slot with tabular digits, so every title starts on the same edge. */
:global(#work .index .row){grid-template-columns:20px minmax(0,1fr) auto}
:global(#work .index .row .n){font-variant-numeric:tabular-nums}
.more-work{margin-top:clamp(40px,5vw,72px)}
.more-work a{display:inline-flex;align-items:center;min-height:44px;font-size:clamp(18px,1.6vw,22px);font-weight:500;letter-spacing:-.015em;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:6px}
.more-work a:hover{text-decoration-thickness:2px}
.more-work a:focus-visible{outline:3px solid var(--focus);outline-offset:4px}
</style>
