---
const summaries = {
  fusion: {
    decision: 'I built a reusable layer on Salt and reviewed custom components with developers.',
    result: 'Fusion shipped to internal users first, then clients. Other Fusion teams reused its widgets and filters.',
    evidence: 'Weekly internal reviews and feedback from two clients informed phase two.',
    href: '#fu-outcome',
  },
  winking: {
    decision: 'I built one board for the family. Each completed routine earns a star and helps the weekly pet grow.',
    result: 'Live on web and iOS. Version 1.0.4 added midnight rollover and accessibility improvements.',
    evidence: 'I observed my own family using it. Adoption and retention figures are pending.',
    href: '#ws-outcome',
  },
  fx: {
    decision: 'I put market context, order progress and repricing in one view. Traders confirm each change.',
    result: 'In beta with internal users. The business and vendor accepted the specification as the build contract.',
    evidence: 'Trader observations informed the design. Rollout results are pending. My public rebuild uses sample data.',
    href: '#fx-outcome',
  },
  deal: {
    decision: 'I designed four role-specific views of one deal record so teams could compare, validate and approve changes.',
    result: 'In use internally. Teams could upload their existing spreadsheets to get started.',
    evidence: 'I spent a year with four teams before moving to Fusion in 2023. The time saving is my estimate.',
    href: '#deal-outcome',
  },
  ai: {
    decision: 'I mapped canvas elements to design-system components and defined fallbacks for missing equivalents.',
    result: 'Private alpha with five-system comparison and React export.',
    evidence: 'The walkthrough shows the working product. External usability testing is still to come.',
    href: '#ai-outcome',
  },
};
interface Props { project: keyof typeof summaries }
const summary = summaries[Astro.props.project];
---
<aside class="case-evidence" aria-label="Case summary">
  <dl>
    <div><dt>My contribution</dt><dd>{summary.decision}</dd></div>
    <div><dt>Delivery</dt><dd>{summary.result}</dd></div>
  </dl>
  <p class="evidence-note">{summary.evidence} <a href={summary.href}>Read the outcome</a></p>
</aside>
<style>
:global(.case-page .chapter-head:has(+ .case-evidence)){margin-bottom:32px}
.case-evidence{margin-top:0;padding-block:var(--space-panel,32px);border-top:1px solid var(--hair);color:var(--fg)}
.case-evidence dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 48px;margin:0}
.case-evidence dt{font:500 16px/1.5 var(--body);margin-bottom:12px}
.case-evidence dd{margin:0;max-width:58ch;font:400 16px/1.65 var(--body);color:var(--fg-2)}
.case-evidence .evidence-note{margin:32px 0 0;max-width:70ch;font:400 14px/1.65 var(--body);color:var(--fg-2)}
.case-evidence a{color:var(--fg);text-underline-offset:4px;white-space:nowrap}
.case-evidence a:focus-visible{outline:3px solid var(--focus);outline-offset:4px}
@media(max-width:760px){.case-evidence dl{grid-template-columns:1fr;gap:32px}.case-evidence{margin-top:0}}
</style>
