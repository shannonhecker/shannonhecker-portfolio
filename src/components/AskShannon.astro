---
import Split from './Split.astro';
import '../styles/ask-shannon.css';
---
<section id="ask" class="band ask-shannon" aria-label="Ask Shannon" data-clarity-mask="true">
  <div class="wrap">
    <div class="ask-head">
      <p class="eyebrow">Shannon’s AI</p>
      <Split as="h2" class="h-section" text="Ask Shannon a question" />
    </div>
    <div class="ask-grid">
      <div class="ask-main">
        <div class="ask-log-wrap">
          <div class="ask-log" id="ask-messages" role="log" aria-live="polite" aria-label="Chat messages" tabindex="0" data-lenis-prevent>
            <div class="ask-msg ask-msg--ai ask-greeting"><p>Hi, I’m Shannon’s AI. Ask me about her design leadership work, uoaui.ai, or the roles she’s looking for next.</p></div>
          </div>
          <button class="ask-follow" type="button" aria-label="Scroll to latest message" hidden>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 2v7m0 0L3 6m3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>New messages</span>
          </button>
        </div>
        <p class="vh" id="ask-status" role="status"></p>
        <form class="ask-form" id="ask-form" autocomplete="off">
          <label for="ask-input" class="vh">Ask Shannon a question</label>
          <textarea class="ask-input" id="ask-input" name="question" rows="2" maxlength="1000" aria-describedby="ask-hint" placeholder="Ask about my work, career, or current projects."></textarea>
          <div class="ask-bar">
            <p class="ask-hint" id="ask-hint">Enter sends. Shift and Enter adds a line.</p>
            <button class="ask-mic" id="ask-mic" type="button" aria-label="Speech to text" title="Speech to text" aria-pressed="false" hidden>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v4M8 23h8"/></svg>
            </button>
            <button class="ask-send" id="ask-send" type="submit">Send</button>
          </div>
        </form>
      </div>
      <aside class="ask-side">
        <p class="ask-side-title" id="ask-try">Try asking</p>
        <div class="ask-suggestions" id="ask-suggestions" role="group" aria-labelledby="ask-try"></div>
        <p class="ask-note">I’m Shannon’s AI. I can be wrong, and Shannon may review chats to improve this portfolio. Don’t share confidential info. <a href="/privacy">Privacy</a>.</p>
      </aside>
    </div>
  </div>
</section>
<script>
  import '../scripts/ask-shannon.ts';
</script>
