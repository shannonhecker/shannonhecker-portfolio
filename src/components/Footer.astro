---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
---
<footer id="links" class="band">
  <div class="wrap">
    <section id="contact" class="foot-contact" aria-labelledby="contact-title">
      <h2 id="contact-title" tabindex="-1">Let’s Talk.</h2>
      <a class="foot-mail" href="mailto:shannonheckerchen@gmail.com" data-cursor="big">Email me directly <span><Icon name="mail" /></span></a>
    </section>
    <p class="copyright"><span class="sig"><Logo size={22} />Shannon Hecker · Product Designer · London</span></p>
    <p class="copyright legal"><span class="legal-links"><a href="/privacy">Privacy</a><button type="button" data-analytics-settings>Analytics settings</button><button type="button" data-avatar-cursor-toggle hidden aria-pressed="true">Avatar cursor on</button></span><span id="analytics-status" role="status"></span></p>
  </div>
</footer>

<style>
.foot-contact{display:flex;align-items:baseline;justify-content:space-between;gap:12px 48px;scroll-margin-top:96px;padding-bottom:clamp(32px,4vw,56px);margin-bottom:clamp(40px,5vw,72px);border-bottom:1px solid var(--hair)}
/* The serif is used here and on the chat heading. Its font file must not be fetched with the page's first
   requests, so the face is applied (by the script below) once the chat or the footer nears the window.
   Until it has loaded the headings stay in the site's own display face, off screen. */
.foot-contact h2{margin:0;font-family:var(--display);font-weight:500;font-size:clamp(44px,6vw,76px);line-height:1;letter-spacing:-.03em}
:global(html.serif-on) .foot-contact h2{font-family:'Noto Serif Display',var(--display)}
.foot-mail{--tap:max(0px,calc((44px - 1.2em) / 2));display:inline-block;padding-block:var(--tap);margin-block:calc(-1 * var(--tap));color:var(--fg);font-family:var(--display);font-weight:500;font-size:clamp(20px,2vw,28px);line-height:1.2;letter-spacing:-.025em;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.2em;white-space:nowrap}
#contact-title:focus:not(:focus-visible){outline:none}
#contact-title:focus-visible{outline:3px solid var(--focus);outline-offset:6px}
.foot-mail:hover{text-decoration-thickness:2px}
.foot-mail:focus-visible{outline:3px solid var(--focus);outline-offset:4px}
@media(max-width:760px){.foot-contact{flex-direction:column;align-items:flex-start}}

/* The small links and buttons at the foot: at least 24px tall, 44px on a phone. The extra height
   is cancelled by an equal negative margin, so the rows look exactly as before. */
.legal-links a,.legal-links button,.copyright a{display:inline-flex;align-items:center;min-height:24px}
.legal-links button{font:inherit;color:inherit;background:none;border:0;padding:0;text-decoration:underline;cursor:pointer}
.legal-links [hidden]{display:none}
@media(max-width:760px){.legal-links a,.legal-links button,.copyright a{min-height:44px;margin-block:-10px}}
/* Room for the analytics notice while it is open (see AnalyticsConsent). */
#links{padding-bottom:calc(var(--space-section) + var(--consent-h,0px))}
/* Keep the footer controls above the mobile analytics notice. */
@media(max-width:760px){
  #links{padding-bottom:calc(48px + var(--consent-h,0px))}
}
</style>

<script>
  // Load the serif (the footer's "Let’s Talk." and the chat heading) only when the first of them is
  // close, so it never competes with first paint. The chat section comes first on the home page.
  const block = document.querySelector('#ask') ?? document.querySelector('.foot-contact');
  // The face is fetched first and switched on only once it is ready, so the headings never pass
  // through a system serif on the way.
  const on = () => {
    const ready = () => document.documentElement.classList.add('serif-on');
    if (document.fonts?.load) document.fonts.load("500 1em 'Noto Serif Display'").then(ready, ready);
    else ready();
  };
  if (block && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { on(); io.disconnect(); }
    }, { rootMargin: '1600px 0px' });
    io.observe(block);
  } else on();
</script>
