---
// Native SVG exports from Analytics UI Design M1, with only the surrounding Figma canvas trimmed.
// On the page each screen is served as an optimised picture rendered from that vector at 2880px
// (the vectors are 0.8 and 1.7 MB, too heavy to be the first thing a phone paints). The link on
// each screen still opens the vector itself, so the full-size view stays sharp at any zoom.
import { Picture } from 'astro:assets';
import discoveryImage from '../assets/fusion/fusion-discovery-2880.webp';
import performanceImage from '../assets/fusion/fusion-performance-2880.webp';
const screens = [
  { image: discoveryImage, full: '/art/fusion-discovery-vector.svg', alt: 'Original Fusion Analytics Dashboard design with report discovery, featured dashboards and the report table' },
  { image: performanceImage, full: '/art/fusion-performance-vector.svg', alt: 'Original Fusion Performance design showing the complete workspace' },
];
const widths = [640, 960, 1280, 1920, 2880];
const sizes = '(max-width: 760px) 74vw, 46vw';
---
<div class="project-hero fusion-hero">
  {screens.map(({ image, full, alt }, index) => (
    <figure class="fusion-screen">
      <a class="full-size-image" href={full} target="_blank" rel="noopener" aria-label={`View full size: ${alt} (opens in new tab)`}>
        <Picture src={image} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} quality={82} loading="eager" decoding="async" fetchpriority={index === 0 ? 'high' : undefined} />
      </a>
    </figure>
  ))}
</div>
<style>
  /* Figma 48:5: discovery upper right, performance in front at lower left.
     Flow layout reserves the entire composition height at every viewport. */
  .project-hero.fusion-hero { display:block; }
  .fusion-screen { position:relative;margin:0;width:79.6%;margin-left:auto; }
  .fusion-screen + .fusion-screen { width:97.56%;margin-left:0;margin-top:-3%; }
  .full-size-image { display:block;border-radius:4px;box-shadow:0 16px 32px -8px rgb(12 12 13 / .4);cursor:zoom-in; }
  .full-size-image:focus-visible { outline:2px solid var(--project-ink,var(--fg));outline-offset:6px; }
  .fusion-screen:focus-within { z-index:1; }
  .fusion-screen :global(picture) { display:block; }
  .fusion-screen :global(img) { display:block;width:100%;height:auto;border-radius:4px; }
</style>
