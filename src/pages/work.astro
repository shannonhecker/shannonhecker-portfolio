---
// The index of everything: the five cases, then the ten earlier projects.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CaseRowLink from '../components/CaseRowLink.astro';
import { CASES } from '../lib/cases';
import { earlierProjects } from '../lib/earlier';

const earlier = await earlierProjects();
---
<Base title="Work · Shannon Hecker">
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" class="work-index">
    <div class="wrap">
      <h1>Work</h1>
    </div>

    <section id="work" class="band work-selected" aria-labelledby="selected-title">
      <div class="wrap">
        <h2 id="selected-title" class="work-label">Selected</h2>
        <div class="index">
          {CASES.map((c) => <CaseRowLink c={c} homeArtwork />)}
        </div>
      </div>
    </section>

    <section class="band work-earlier" aria-labelledby="earlier-title">
      <div class="wrap">
        <h2 id="earlier-title" class="work-label">Earlier work</h2>
        <ul class="earlier-list">
          {earlier.map((p) => (
            <li>
              <a href={`/work/${p.id}`} data-cursor="big">
                <h3>{p.data.title}</h3>
                <p class="summary">{p.data.summary}</p>
                <span class="dates">{p.data.dates}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
.work-index{padding-top:clamp(120px,11vw,168px)}
.work-index h1{font-size:clamp(42px,4.8vw,80px);line-height:1.05;letter-spacing:-.045em}
.work-index .wrap{max-width:1440px}
.work-index .work-selected{padding-top:clamp(48px,6vw,96px);padding-bottom:0}
.work-index .work-earlier{padding-top:clamp(72px,9vw,144px);padding-bottom:clamp(72px,9vw,144px)}
.work-index .work-label{margin:0 0 clamp(32px,4vw,56px);font:500 clamp(22px,2vw,28px)/1.2 var(--display,var(--body));letter-spacing:-.025em}
.earlier-list{border-top:1px solid var(--hair)}
.earlier-list a{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr) 140px;gap:8px clamp(16px,3vw,48px);align-items:baseline;padding-block:clamp(20px,2.4vw,32px);border-bottom:1px solid var(--hair);text-decoration:none}
.earlier-list h3{margin:0;font-size:clamp(20px,1.8vw,24px);font-weight:600;line-height:1.3;letter-spacing:-.015em}
.earlier-list .summary{margin:0;font-size:15px;line-height:1.7;color:var(--fg-2);max-width:60ch}
.earlier-list .dates{font-size:14px;line-height:1.7;color:var(--fg-2);text-align:right}
.earlier-list a:hover h3{text-decoration:underline;text-underline-offset:5px}
.earlier-list a:focus-visible{outline:2px solid var(--project-ink,var(--fg));outline-offset:-2px}
@media(max-width:900px){
  .earlier-list a{grid-template-columns:minmax(0,1fr)}
  .earlier-list .dates{text-align:left;grid-row:2}
  .earlier-list .summary{grid-row:3}
}
</style>
