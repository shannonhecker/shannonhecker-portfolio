---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WaveField from '../components/WaveField.astro';
import CaseRowLink from '../components/CaseRowLink.astro';
import Icon from '../components/Icon.astro';
import { projectOverviews } from '../lib/project-overviews';
import { CASES } from '../lib/cases';
import { earlierProjects } from '../lib/earlier';
import '../styles/project-gallery.css';
const earlier = await earlierProjects();
---
<Base title="Work · Shannon Hecker" description="Fifteen projects across trading, analytics, design systems and independent products by Shannon Hecker.">
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" class="work-index">
    <header class="work-head has-wave-field">
      <WaveField variant="work" />
      <div class="wrap">
        <h1>All work</h1>
        <p class="work-meta">{CASES.length + earlier.length} projects</p>
      </div>
    </header>
    <div class="wrap" id="work">
      <div class="index project-gallery all-gallery">
        {CASES.map((c, index) => <CaseRowLink c={c} homeArtwork heading="h2" priority={index < 3} description={projectOverviews[c.href].card} />)}
        {earlier.map((project, index) => (
          <a class="archive-card" id={index===0?'earlier-title':undefined} href={`/work/${project.id}`} data-cursor="big">
            <Picture src={project.data.cover} alt="" formats={['avif']} fallbackFormat="webp" widths={[360,720,1080]} sizes="(max-width: 600px) 92vw, (max-width: 900px) 46vw, 31vw" quality={75} loading="lazy" decoding="async" />
            <h2 class="project-title">{project.data.title}<Icon name="arrow-right" class="arrow" /></h2>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Base>
