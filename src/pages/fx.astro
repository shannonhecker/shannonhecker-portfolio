---
import CasePage from '../layouts/CasePage.astro';
import Icon from '../components/Icon.astro';
---
<CasePage title="FX execution analytics" href="/fx">
  <img class="nda-cover" src="/art/execution-mockup-1600.avif" srcset="/art/execution-mockup-700.avif 700w, /art/execution-mockup-1600.avif 1600w" sizes="(max-width:1100px) 92vw, 1040px" alt="My FX execution dashboard mockup with sample trading data." width="1600" height="1000" fetchpriority="high" />
  <div slot="notice" class="nda-summary">
    <aside aria-labelledby="nda-heading">
      <span class="lock"><Icon name="lock" /></span>
      <h2 id="nda-heading">This work is under NDA.</h2>
      <p>I built this mockup with sample data for my portfolio. The Barclays interface is confidential. I’m happy to discuss my role <a href="mailto:shannonheckerchen@gmail.com">on a call</a>.</p>
    </aside>
    <dl>
      <div><dt>Organisation</dt><dd>Barclays</dd></div>
      <div><dt>Period</dt><dd>2025 to now</dd></div>
      <div><dt>My role</dt><dd>Lead product designer</dd></div>
    </dl>
  </div>
</CasePage>
<style>
.nda-cover{display:block;width:100%;height:auto;border-radius:var(--radius)}
.nda-summary{max-width:1040px;margin:auto}
aside{padding:clamp(20px,3vw,36px);border:1px solid var(--hair);border-radius:12px;background:var(--bg-2)}
.lock{display:grid;place-items:center;width:36px;height:36px;margin-bottom:16px;border-radius:8px;background:var(--fg);color:var(--bg)}
h2,dd{font:500 clamp(18px,2vw,24px)/1.35 var(--body);letter-spacing:-.025em}
h2,p,dd,dl{margin:0}
p{max-width:52ch;margin-top:6px;color:var(--fg-2);line-height:1.55}a{color:var(--fg);text-underline-offset:3px}
dl{margin-top:clamp(24px,4vw,48px);border-top:1px solid var(--hair)}
dl div{padding:16px 0;border-bottom:1px solid var(--hair)}
dt{margin-bottom:5px;color:var(--fg-2);font-size:14px}
</style>
