---
// About me. The words are the old About page's and the old home page's About
// section, as written there; docs/superpowers/review/about-changes.md lists every
// place where they differ (job titles and dates, the opening line, the description)
// and every personal detail carried over. The page head is the Work and Writing
// head: a very large title, a small line at its foot, a hairline. Below it the page
// uses the essays' column structure (a label column, then the text) so the three
// read as one family.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import photo from '../assets/about/photo.webp';
import '../styles/about.css';

const description = 'Product designer in London. Fifteen years in design, 10+ in fintech. Trading platforms, design systems, and accessible enterprise UX at Barclays and J.P. Morgan.';

// The panel home hero's intro paragraph (src/components/Hero.astro), word for word.
const intro = "Hi, I’m Shannon Hecker, a product designer in London. I lead design for FX and MarketsOne at Barclays. Before that, I was Digital Product Designer VP at J.P. Morgan. I build what I design.";

type Job = { company: string; dates: string; current?: boolean; role?: string; roles?: { title: string; dates: string }[]; summary: string };
// Newest first, as the old page listed them.
const jobs: Job[] = [
  { company: 'uoaui.ai', dates: '2026 to present', current: true, role: 'Designer + Builder', summary: 'Started, designed, and built an AI design-system builder. UI Kit plus private-preview Builder across Salt, Material 3, Fluent 2, Carbon, and the uoaui system. In private alpha. I own product strategy, research, interaction design, brand, and front-end build.' },
  { company: 'Barclays, London', dates: 'Sep 2025 to present', current: true, role: 'Lead Product Designer', summary: 'Sole designer on FX, covering trader, sales, ops, institutional and corporate-client surfaces. Leading a design system refactor across the platform. Most visual work is under NDA; happy to walk through it in an interview.' },
  { company: 'J.P. Morgan, London', dates: 'Aug 2016 to Sep 2025', roles: [{ title: 'Digital Product Designer VP', dates: 'Feb 2023 to Sep 2025' }, { title: 'User Experience Designer', dates: 'Aug 2016 to Jan 2023' }], summary: 'User Experience Designer from 2016, then Digital Product Designer VP on Fusion from 2023. Led UI for Fusion Analytics, defining component structure and Salt accessibility patterns. Before Fusion, led UI on Deal Model in Securities Services, with two UX designers and teams across custody ops, sales, legal and product. Contributed to the Fusion Design System.' },
  { company: 'Pegasus Global Travel, London', dates: '2015', role: 'Graphic Designer', summary: 'Designed the company website end to end, plus promotional assets and video content. Brought the brand into one system across channels.' },
  { company: 'Genuine C&C Inc, Taiwan', dates: '2011 to 2015', role: 'Visual Designer & Web Developer', summary: 'Designed and maintained the B2B platform. Built the corporate website front-end. Led UI/UX direction for a client-facing network platform.' },
  { company: 'Eastern Shine Production Co., Ltd.', dates: '2011', role: 'Website Designer, Graphic Designer', summary: 'Designed web platforms with a usability focus. Art-directed a government video project from concept to delivery.' },
  { company: 'Reeborn Information Co., Ltd.', dates: '2008 to 2010', role: 'Website Designer', summary: 'Designed corporate visual identity and web platform interfaces. Produced digital content and product photography for e-commerce.' },
];

const expertise = [
  'AI-assisted product design', 'Design strategy for enterprise software', 'Visual design at high fidelity', 'Design systems (advanced Figma)',
  'Research with expert users', 'Design mentoring & leadership', 'Multi-stakeholder design decisions', 'Accessibility (WCAG 2.1 AA)',
  'Trading platform UI/UX', 'Data visualisation',
];

const education = [
  { dates: '2015 to 2016', name: 'London Metropolitan University', detail: 'MA Digital Media' },
  { dates: '2008 to 2010', name: 'Ling Tung University, Taiwan', detail: 'BA Digital Media Arts & Management' },
];

const outside = [
  'Based just outside London, a 40-minute ride from King’s Cross.',
  'Taiwan-born. English and Mandarin.',
  'Married with two kids, plus one fluffy cat called Quorra.',
  'Soya latte, extra shot. Strong leaf tea on design days.',
];

const page = new URL('/about', Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About me',
  url: page,
  description,
  inLanguage: 'en-GB',
  mainEntity: { '@type': 'Person', name: 'Shannon Hecker', url: 'https://shannonhecker.com', jobTitle: 'Product Designer' },
};
---
<Base title="About me · Shannon Hecker" description={description}>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" class="about-page">
    <header class="about-head">
      <div class="wrap">
        <h1>About me</h1>
        <p class="about-meta">Designing what traders and analysts use every day.</p>
      </div>
    </header>

    <section class="about-intro" aria-labelledby="who-title">
      <div class="wrap">
        <figure class="about-photo" style={`--w:${photo.width}px`}>
          <Picture src={photo} alt="Shannon Hecker in a gallery" formats={['webp']} fallbackFormat="webp" widths={[448, 640, 896]} sizes="(max-width: 900px) 100vw, 40vw" quality={90} loading="eager" decoding="async" />
        </figure>
        <div class="about-who">
          <h2 id="who-title" class="about-kicker">Who I am</h2>
          <p class="about-lede">{intro}</p>
          <p class="about-prose">At <strong>Barclays</strong>, running the design system across FX and MarketsOne: tokens, components, and accessibility. Before that, nine years at <strong>J.P.&nbsp;Morgan</strong>, ending as Digital Product Designer VP on Fusion. Building <strong>uoaui.ai</strong> on the side, in private alpha.</p>
          <ul class="about-links">
            <li><a href="https://www.linkedin.com/in/shannonhecker" target="_blank" rel="noopener noreferrer" data-cursor="big">LinkedIn<span aria-hidden="true"> ↗</span><span class="vh"> (opens in new tab)</span></a></li>
            <li><a href="mailto:shannonheckerchen@gmail.com" data-cursor="big">Email<span aria-hidden="true"> ↗</span></a></li>
            <li><a href="/assets/CV_ShannonH.pdf" target="_blank" rel="noopener noreferrer" data-cursor="big">Résumé<span aria-hidden="true"> ↗</span><span class="vh"> (opens in new tab)</span></a></li>
          </ul>
        </div>
        <dl class="about-facts">
          <div><dt>15 yrs</dt><dd>In design, ten of them in fintech</dd></div>
          <div><dt>9 yrs</dt><dd>At J.P.&nbsp;Morgan, ending as Digital Product Designer VP</dd></div>
          <div><dt>AA WCAG</dt><dd>The standard I design to</dd></div>
        </dl>
      </div>
    </section>

    <section class="about-section about-approach" aria-labelledby="approach-title">
      <div class="wrap">
        <div class="about-label"><h2 id="approach-title">My approach</h2></div>
        <div class="about-content">
          <p class="about-statement">I design what traders and analysts use every day. Trading floors. AI tools.</p>
          <p class="about-prose">Ten years designing for engineering, quant, and ops audiences inside banks, plus the clients who use the same data. I prototype early, run quick research loops, and pressure-test decisions with product and engineering before the pixels harden.</p>
          <p class="about-prose">Design systems and modern tooling, including AI where it helps, speed delivery without losing clarity. The goal is simple: accessible interfaces teams can ship and keep iterating on.</p>
        </div>
      </div>
    </section>

    <section class="about-section about-now" aria-labelledby="now-title">
      <div class="wrap">
        <div class="about-label"><h2 id="now-title">Now</h2></div>
        <dl class="about-content about-rows">
          <div><dt>Shipping.</dt><dd>Design system at Barclays across FX and MarketsOne.</dd></div>
          <div><dt>Reading.</dt><dd><em>Designing Machine Learning Systems</em> by Chip Huyen.</dd></div>
          <div><dt>Writing.</dt><dd><a href="/writing/the-design-system-is-the-contract" data-cursor="big">The design system is the contract</a>.</dd></div>
          <div><dt>Experimenting.</dt><dd>uoaui.ai in private alpha.</dd></div>
        </dl>
      </div>
    </section>

    <section class="about-section about-experience" aria-labelledby="experience-title">
      <div class="wrap">
        <div class="about-label"><h2 id="experience-title">Experience</h2><p class="about-kicker">Career</p></div>
        <ol class="about-content about-jobs">
          {jobs.map((job) => (
            <li class="about-job">
              <p class:list={['about-dates', { 'is-current': job.current }]}>{job.dates}</p>
              <span class:list={['about-rail', { 'is-current': job.current }]} aria-hidden="true"></span>
              <div class="about-job-main">
                <h3>{job.company}</h3>
                {job.role && <p class="about-role">{job.role}</p>}
                {job.roles && (
                  <ul class="about-roles">
                    {job.roles.map((r) => <li><span class="about-role">{r.title}</span><span class="about-role-dates">{r.dates}</span></li>)}
                  </ul>
                )}
                <p class="about-prose">{job.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="about-section about-expertise" aria-labelledby="expertise-title">
      <div class="wrap">
        <div class="about-label"><h2 id="expertise-title">Expertise</h2><p class="about-kicker">Capabilities</p></div>
        <ul class="about-content about-list about-list--two">
          {expertise.map((e) => <li>{e}</li>)}
        </ul>
      </div>
    </section>

    <section class="about-section about-education" aria-labelledby="education-title">
      <div class="wrap">
        <div class="about-label"><h2 id="education-title">Education</h2></div>
        <ul class="about-content about-schools">
          {education.map((e) => (
            <li>
              <p class="about-dates">{e.dates}</p>
              <div>
                <h3>{e.name}</h3>
                {e.detail && <p class="about-role">{e.detail}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="about-section about-outside" aria-labelledby="outside-title">
      <div class="wrap">
        <div class="about-label"><h2 id="outside-title">Outside work</h2></div>
        <ul class="about-content about-list">
          {outside.map((o) => <li>{o}</li>)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>
