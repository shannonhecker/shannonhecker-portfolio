---
import Icon from '../../components/Icon.astro';
// The index of the essays, newest first. The page head uses the Work page's own
// scale (a very large title, its count, a hairline) so the two read as siblings.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import WaveField from '../../components/WaveField.astro';
import intro from '../../data/writing-index.json';
import { bodyStats, displayDate, isoDate, writingEntries } from '../../lib/writing';
import '../../styles/writing.css';

const entries = await writingEntries();
---
<Base title="Writing · Shannon Hecker" description={intro.description}>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main" class="writing-index">
    <header class="writing-head has-wave-field">
      <WaveField variant="writing" />
      <div class="wrap">
        <p class="writing-meta">Writing</p>
        <h1>{intro.title}</h1>
        <p class="writing-dek">{intro.dek}</p>
      </div>
    </header>

    <section class="writing-listing" aria-label="Essays">
      <div class="wrap">
        <ol class="writing-list">
          {entries.map((e) => (
            <li>
              <a href={`/writing/${e.id}`} data-cursor="big">
                <h2 class="title">{e.data.title}.</h2>
                <span class="writing-row-meta"><time class="date" datetime={isoDate(e.data.published)}>{displayDate(e.data.published)}</time> <span aria-hidden="true">·</span> <span class="read-time">{bodyStats(e).minutes} min</span></span>
                <p class="blurb">{e.data.blurb}</p>
                <span class="read">Read essay <Icon name="arrow-right" class="arrow" /></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
  <Footer />
</Base>
